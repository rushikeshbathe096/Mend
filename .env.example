# ============================================================
# Mend Environment Variables — TEMPLATE
# ============================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL Database Configuration ---
POSTGRES_DB=mend
POSTGRES_USER=mend_user
POSTGRES_PASSWORD=              # REQUIRED — set a strong password

# Spring Boot Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/mend
SPRING_DATASOURCE_USERNAME=mend_user
SPRING_DATASOURCE_PASSWORD=     # REQUIRED — must match POSTGRES_PASSWORD
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379
MEND_REDIS_STREAM_NAME=mend:webhooks
MEND_REDIS_CONSUMER_GROUP=mend-webhook-processors
MEND_REDIS_ENABLED=true

# --- AI Service Configuration ---
MEND_AI_BASE_URL=http://localhost:8000
MEND_BACKEND_URL=http://localhost:8080
MEND_AI_INTERNAL_TOKEN=         # OPTIONAL — required when AI service is exposed outside localhost
MEND_CHECKPOINT_POSTGRES_URI=   # OPTIONAL — PostgreSQL URI for LangGraph multi-instance checkpointer (e.g., postgresql://mend_user:password@localhost:5433/mend)
LANGGRAPH_STRICT_MSGPACK=true

# --- LLM Provider Credentials (Optional — bounded heuristic fallback used if missing) ---
GEMINI_API_KEY=                 # OPTIONAL — Google Gemini API key
OPENAI_API_KEY=                 # OPTIONAL — OpenAI API key

# --- Payment Provider Configuration ---
# Options: mock (for dev/test) or razorpay (for production/test mode)
MEND_PAYMENT_PROVIDER=mock

# Razorpay API Credentials (obtain from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=                # REQUIRED when MEND_PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_SECRET=            # REQUIRED when MEND_PAYMENT_PROVIDER=razorpay
RAZORPAY_WEBHOOK_SECRET=        # REQUIRED — configured independently in Razorpay Webhooks settings

# --- JWT Authentication ---
# Generate with: openssl rand -base64 48
JWT_SECRET=                     # REQUIRED — minimum 32 bytes (256 bits)
JWT_EXPIRATION=86400000

# --- Developer Options ---
MEND_DEV_SEED=false             # MUST be false in production
