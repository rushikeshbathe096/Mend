# PostgreSQL Configuration
POSTGRES_DB=mend
POSTGRES_USER=mend_user
POSTGRES_PASSWORD=mend_password

# Spring Boot Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/mend
SPRING_DATASOURCE_USERNAME=mend_user
SPRING_DATASOURCE_PASSWORD=mend_password
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
MEND_REDIS_STREAM_NAME=mend:webhook-events
MEND_REDIS_CONSUMER_GROUP=mend-processors

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Razorpay (Phase 3+)
RAZORPAY_KEY_ID=placeholder_key
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_razorpay_webhook_secret

# JWT (Phase 3+)
JWT_SECRET=placeholder_jwt_secret
