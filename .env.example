# ============================================================
# Mend Environment Variables — TEMPLATE
# ============================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to version control.
# ============================================================

# PostgreSQL Configuration
POSTGRES_DB=mend
POSTGRES_USER=mend_user
POSTGRES_PASSWORD=              # REQUIRED — set a strong password

# Spring Boot Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/mend
SPRING_DATASOURCE_USERNAME=mend_user
SPRING_DATASOURCE_PASSWORD=     # REQUIRED — must match POSTGRES_PASSWORD
SPRING_JPA_HIBERNdjATE_DDL_AUTO=validate

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
MEND_REDIS_STREAM_NAME=mend:webhook-events
MEND_REDIS_CONSUMER_GROUP=mend-processors

# AI Service
MEND_AI_BASE_URL=http://localhost:8000

# Razorpay — obtain from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=                # REQUIRED for razorpay provider mode
RAZORPAY_KEY_SECRET=            # REQUIRED for razorpay provider mode
RAZORPAY_WEBHOOK_SECRET=        # REQUIRED — from Razorpay webhook settings

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=                     # REQUIRED — minimum 32 bytes
